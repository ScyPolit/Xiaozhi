[Unit]
Description=Xiaozhi OpenClaw WebSocket Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=XiaoZhi
Group=XiaoZhi
WorkingDirectory=/home/XiaoZhi/zhihe/WebServer
EnvironmentFile=/home/XiaoZhi/zhihe/WebServer/.env
ExecStart=/home/XiaoZhi/zhihe/WebServer/.venv/bin/python -m xiaozhi_gateway
Restart=always
RestartSec=3
MemoryMax=700M

[Install]
WantedBy=multi-user.target

