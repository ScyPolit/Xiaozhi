[Unit]
Description=ZhiHe local model protocol adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=XiaoZhi
Group=XiaoZhi
WorkingDirectory=/home/XiaoZhi/zhihe/WebServer
ExecStart=/home/XiaoZhi/zhihe/WebServer/.venv/bin/python /home/XiaoZhi/zhihe/WebServer/scripts/pollinations_proxy.py
Restart=always
RestartSec=5
MemoryMax=100M

[Install]
WantedBy=multi-user.target
